{
    "name": "casablanca/bookingengine-connector",
    "type": "typo3-cms-extension",
    "description": "CASABLANCA Booking Engine Integration for TYPO3 — asynchronous ARI synchronisation, SSR widgets, and PCI DSS-safe redirect handover to the IBE v2.",
    "homepage": "https://www.casablanca.at/",
    "license": "AGPL-3.0-only",
    "keywords": ["TYPO3 CMS", "hotel", "booking engine", "ibe", "casablanca", "pms", "availability"],
    "authors": [
        {
            "name": "Martin Hairer",
            "email": "support@casablanca.at",
            "homepage": "https://www.casablanca.at/",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "typo3/cms-core": "^12.4 || ^13.4 || ^14.0",
        "typo3/cms-extbase": "^12.4 || ^13.4 || ^14.0",
        "typo3/cms-fluid": "^12.4 || ^13.4 || ^14.0",
        "typo3/cms-frontend": "^12.4 || ^13.4 || ^14.0",
        "typo3/cms-backend": "^12.4 || ^13.4 || ^14.0",
        "typo3/cms-scheduler": "^12.4 || ^13.4 || ^14.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "typo3/testing-framework": "^8.0 || ^9.0",
        "typo3/tailor": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "autoload": {
        "psr-4": {
            "Casablanca\\CasablancaBooking\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Casablanca\\CasablancaBooking\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "casablanca_booking"
        }
    }
}
