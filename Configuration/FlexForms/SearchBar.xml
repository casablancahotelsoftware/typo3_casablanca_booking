                    </settings.defaultChildrenAges>

                    <settings.language>
                        <label>LLL:EXT:casablanca_booking/Resources/Private/Language/locallang_db.xlf:flexform.language.label</label>
                        <description>LLL:EXT:casablanca_booking/Resources/Private/Language/locallang_db.xlf:flexform.language.description</description>
